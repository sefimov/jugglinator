<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Сводка в меню: «3 задачи, 1 сделана» (TaskListPresenter.summary); вопрос «Удалить все N задач?» (clearAll.confirm). -->
<plist version="1.0">
<dict>
	<key>summary.tasks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@tasks@</string>
		<key>tasks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld tâche</string>
			<key>many</key>
			<string>%lld de tâches</string>
			<key>other</key>
			<string>%lld tâches</string>
		</dict>
	</dict>
	<key>summary.done</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@done@</string>
		<key>done</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld terminée</string>
			<key>many</key>
			<string>%lld terminées</string>
			<key>other</key>
			<string>%lld terminées</string>
		</dict>
	</dict>
	<key>clearAll.confirm</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@tasks@</string>
		<key>tasks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Supprimer %lld tâche ?</string>
			<key>many</key>
			<string>Supprimer toutes les %lld de tâches ?</string>
			<key>other</key>
			<string>Supprimer toutes les %lld tâches ?</string>
		</dict>
	</dict>
	<key>clearDone.confirm</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@tasks@</string>
		<key>tasks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Supprimer %lld tâche terminée ?</string>
			<key>many</key>
			<string>Supprimer %lld de tâches terminées ?</string>
			<key>other</key>
			<string>Supprimer %lld tâches terminées ?</string>
		</dict>
	</dict>
</dict>
</plist>
