<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Сводка в меню: «3 задачи, 1 сделана» (TaskListPresenter.summary); вопрос «Удалить все N задач?» (clearAll.confirm). -->
<plist version="1.0">
<dict>
	<key>summary.tasks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@tasks@</string>
		<key>tasks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld tarefa</string>
			<key>many</key>
			<string>%lld de tarefas</string>
			<key>other</key>
			<string>%lld tarefas</string>
		</dict>
	</dict>
	<key>summary.done</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@done@</string>
		<key>done</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld concluída</string>
			<key>many</key>
			<string>%lld concluídas</string>
			<key>other</key>
			<string>%lld concluídas</string>
		</dict>
	</dict>
	<key>clearAll.confirm</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@tasks@</string>
		<key>tasks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Excluir %lld tarefa?</string>
			<key>many</key>
			<string>Excluir todas as %lld de tarefas?</string>
			<key>other</key>
			<string>Excluir todas as %lld tarefas?</string>
		</dict>
	</dict>
</dict>
</plist>
