<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Сводка в меню: «3 задачи, 1 сделана» (TaskListPresenter.summary); вопрос «Удалить все N задач?» (clearAll.confirm). -->
<plist version="1.0">
<dict>
	<key>summary.tasks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@tasks@</string>
		<key>tasks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld tarea</string>
			<key>many</key>
			<string>%lld de tareas</string>
			<key>other</key>
			<string>%lld tareas</string>
		</dict>
	</dict>
	<key>summary.done</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@done@</string>
		<key>done</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld hecha</string>
			<key>many</key>
			<string>%lld hechas</string>
			<key>other</key>
			<string>%lld hechas</string>
		</dict>
	</dict>
	<key>clearAll.confirm</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@tasks@</string>
		<key>tasks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>¿Eliminar %lld tarea?</string>
			<key>many</key>
			<string>¿Eliminar todas las %lld de tareas?</string>
			<key>other</key>
			<string>¿Eliminar todas las %lld tareas?</string>
		</dict>
	</dict>
	<key>clearDone.confirm</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@tasks@</string>
		<key>tasks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>¿Eliminar %lld tarea hecha?</string>
			<key>many</key>
			<string>¿Eliminar %lld de tareas hechas?</string>
			<key>other</key>
			<string>¿Eliminar %lld tareas hechas?</string>
		</dict>
	</dict>
</dict>
</plist>
